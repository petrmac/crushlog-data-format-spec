{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cldf.io/schemas/locations.schema.json",
  "title": "CLDF Locations",
  "description": "Climbing locations data",
  "type": "object",
  "required": ["locations"],
  "properties": {
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/location"
      }
    }
  },
  "definitions": {
    "location": {
      "type": "object",
      "required": ["id", "name", "isIndoor"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique identifier for the location (legacy)"
        },
        "clid": {
          "type": "string",
          "pattern": "^clid:v\\d+:location:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "CrushLog ID - globally unique identifier (v1.3.0+)"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the climbing location"
        },
        "coordinates": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": ["latitude", "longitude"]
        },
        "country": {
          "type": "string",
          "description": "Country name"
        },
        "state": {
          "type": "string",
          "description": "State or province"
        },
        "city": {
          "type": "string",
          "description": "City or town name"
        },
        "address": {
          "type": "string",
          "description": "Street address"
        },
        "isIndoor": {
          "type": "boolean",
          "description": "Whether this is an indoor climbing location"
        },
        "starred": {
          "type": "boolean",
          "default": false,
          "description": "Whether this location is marked as favorite"
        },
        "rockType": {
          "$ref": "#/definitions/rockType"
        },
        "terrainType": {
          "$ref": "#/definitions/terrainType"
        },
        "accessInfo": {
          "type": "string",
          "description": "Access information and directions"
        },
        "media": {
          "$ref": "media.schema.json",
          "description": "Media associated with this location (overview, approach photos, etc.)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "customFields": {
          "type": "object",
          "description": "Additional custom fields"
        },
        "gradeScales": {
          "type": "array",
          "description": "Grading scales used at this location, such as a gym's numbered or coloured levels (see grades.md)",
          "items": {
            "$ref": "#/definitions/gradeScale"
          }
        }
      }
    },
    "gradeScale": {
      "type": "object",
      "description": "A ladder of levels, each starting at a grade on the difficulty axis",
      "required": ["id", "levels", "updatedAt"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Globally unique id of the scale. Climbs refer to it in grades.scale.id."
        },
        "climbType": {
          "type": "string",
          "enum": ["boulder", "route"],
          "description": "The kind of climb the scale grades. Boulder when absent."
        },
        "spread": {
          "type": "string",
          "enum": ["even", "widerTop"],
          "description": "How the levels were laid out when the scale was created. Informational."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the scale last changed. Of two copies of a scale, the newer one wins."
        },
        "deletedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Set when the scale was removed. A removed scale stays listed so that climbs logged on it still resolve."
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "description": "The levels, easiest first, with strictly increasing startNumeric",
          "items": {
            "type": "object",
            "required": ["level", "startGrade", "startNumeric"],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1,
                "description": "Level number, from 1 (easiest)"
              },
              "startGrade": {
                "type": "string",
                "description": "The grade where the level starts: a Font grade for a boulder scale, a French grade for a route scale"
              },
              "startNumeric": {
                "type": "integer",
                "minimum": 0,
                "description": "The value of startGrade on the difficulty axis"
              },
              "color": {
                "type": "string",
                "description": "Optional colour of the level, as a name or a hex value"
              }
            }
          }
        }
      }
    },
    "rockType": {
      "type": "string",
      "enum": [
        "sandstone",
        "limestone",
        "granite",
        "basalt",
        "gneiss",
        "quartzite",
        "conglomerate",
        "schist",
        "dolomite",
        "slate",
        "rhyolite",
        "gabbro",
        "volcanicTuff",
        "andesite",
        "chalk"
      ]
    },
    "terrainType": {
      "type": "string",
      "enum": ["natural", "artificial"]
    }
  }
}